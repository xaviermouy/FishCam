# WittyPi Schedule for Puerto Rico Deployment
# Local time: 7:00 AM - 7:00 PM (AST, UTC-4)
# UTC time: 11:00 AM - 11:00 PM
# 2h55m recording cycles with 5-minute downtime (3-hour blocks, starts on the hour)
# Repeat daily

BEGIN	2015-08-01 11:00:00
END	2050-12-31 23:59:59

# Daytime recording cycles (7AM - 7PM Puerto Rico time = 11:00 - 23:00 UTC)
ON	H2 M55		# Cycle 1: 11:00 - 13:55 UTC (7:00 AM - 9:55 AM local)
OFF	M5		# Downtime: 13:55 - 14:00 UTC
ON	H2 M55		# Cycle 2: 14:00 - 16:55 UTC (10:00 AM - 12:55 PM local)
OFF	M5		# Downtime: 16:55 - 17:00 UTC
ON	H2 M55		# Cycle 3: 17:00 - 19:55 UTC (1:00 PM - 3:55 PM local)
OFF	M5		# Downtime: 19:55 - 20:00 UTC
ON	H3  		# Cycle 4: 20:00 - 23:00 UTC (4:00 PM - 6:00 PM local)

# Night shutdown (7PM - 7AM Puerto Rico time = 23:00 - 11:00 UTC)
OFF	H12		# Off for 12 hours until 11:00 UTC next day

WATCHDOG 180